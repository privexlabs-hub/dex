{
  "name": "dex",
  "version": "0.1.0",
  "private": true,
  "description": "DeX \u2014 AI product marketing, video creation and creative production platform",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12 <27",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "db:generate": "pnpm --filter @dex/db generate",
    "db:migrate": "pnpm --filter @dex/db migrate",
    "db:seed:dev": "pnpm --filter @dex/db seed:dev",
    "audit": "pnpm audit --prod --audit-level high",
    "infra:up": "docker compose -f docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f docker/docker-compose.yml down",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@dex/config": "workspace:*",
    "dependency-cruiser": "18.7.2",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6"
  }
}
