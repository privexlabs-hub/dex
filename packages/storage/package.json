{
  "name": "@dex/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private S3-compatible object storage with short-lived signed URLs and tenant-prefixed keys",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dex/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
