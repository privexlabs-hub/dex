{
  "name": "@dex/queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed BullMQ queues, job contracts and worker factory",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "bullmq": "6.6.0",
    "ioredis": "5.11.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dex/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
