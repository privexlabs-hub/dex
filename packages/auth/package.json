{
  "name": "@dex/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Better Auth configuration for the customer realm and the isolated staff realm",
  "exports": {
    "./customer": {
      "types": "./dist/customer.d.ts",
      "import": "./dist/customer.js"
    },
    "./staff": {
      "types": "./dist/staff.d.ts",
      "import": "./dist/staff.js"
    },
    "./client/customer": {
      "types": "./dist/client/customer.d.ts",
      "import": "./dist/client/customer.js"
    },
    "./client/staff": {
      "types": "./dist/client/staff.d.ts",
      "import": "./dist/client/staff.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.16",
    "@dex/db": "workspace:*",
    "@dex/domain": "workspace:*",
    "@dex/email": "workspace:*",
    "better-auth": "1.7.16",
    "drizzle-orm": "0.45.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dex/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
