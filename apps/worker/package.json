{
  "name": "@dex/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background worker process. ROLE selects which queues it consumes.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/main.ts",
    "start": "node --env-file-if-exists=../../.env.local dist/main.js"
  },
  "dependencies": {
    "@dex/db": "workspace:*",
    "@dex/domain": "workspace:*",
    "@dex/env": "workspace:*",
    "@dex/observability": "workspace:*",
    "@dex/queue": "workspace:*",
    "@dex/storage": "workspace:*",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dex/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
