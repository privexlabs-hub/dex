    "better-auth": "1.7.16",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@dex/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
