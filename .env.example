# ---------------------------------------------------------------------------
# DeX environment template. Copy to .env (git-ignored). Placeholders only.
# Production secrets live in the secrets manager (ADR-016), never in files.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=debug

# --- Database (Neon in staging/prod; Docker Postgres locally) ---------------
# Non-owner application role. RLS policies apply to this role.
DATABASE_URL=postgres://dex_app:dex_app_dev@localhost:5432/dex
# Owner role used only for migrations and dev seeds.
DATABASE_ADMIN_URL=postgres://dex_admin:dex_admin_dev@localhost:5432/dex
DATABASE_POOL_MAX=10

# --- Redis (BullMQ) ---------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3 API: MinIO locally, R2 in prod) ---------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=dex-media
S3_ACCESS_KEY_ID=dex_minio
S3_SECRET_ACCESS_KEY=dex_minio_dev
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=600

# --- Customer auth realm (apps/web) ----------------------------------------
# Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-48-byte-base64-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Staff auth realm (apps/admin) — separate secret, separate tables -------
STAFF_AUTH_SECRET=replace-with-a-different-random-48-byte-base64-secret
STAFF_AUTH_URL=http://localhost:3100
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100
STAFF_IP_ALLOWLIST=
STAFF_REQUIRE_MFA=false

# --- Email (Mailpit locally) -----------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@dex.test
SMTP_URL=smtp://localhost:1025

# --- Observability (optional locally) --------------------------------------
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=
