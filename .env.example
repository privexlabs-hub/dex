# =============================================================================
# DeX environment reference. Committed. Placeholders only, never real secrets.
#
#   .env.local       Your machine. Loaded automatically by every pnpm script.
#                    Create it with the commands in docs/SETUP.md, step 3.
#   .env.production  Fill-in sheet for production values. NEVER loaded by the
#                    apps. Import it into Fly or the secrets manager (ADR-016).
#
# Both are git-ignored and docker-ignored. Real environment variables always win
# over .env.local. Restart `pnpm dev` after editing it. `KEY=` means "not set".
# Full walkthrough, including where to get each key: docs/SETUP.md
#
# Each entry below lists:
#   Used by    the processes that read it
#   Local      the value for local development
#   Prod       the value for production and where to get it
# =============================================================================

# --- Application -------------------------------------------------------------

# Which environment this is. One of: development, test, staging, production.
# staging/production switch cookies to Secure, and block the dev seed scripts.
# Used by: web, admin, worker, db seed, bucket init
# Local: development   Prod: production
APP_ENV=development

# Log verbosity. One of: trace, debug, info, warn, error, fatal. Default: info.
# Used by: web, admin, worker
# Local: debug   Prod: info
LOG_LEVEL=debug

# --- Database (Postgres) -----------------------------------------------------

# Connection for the running apps. MUST be the non-owner role `dex_app`,
# otherwise Row-Level Security does not apply and tenant isolation is lost.
# Used by: web, admin, worker
# Local: the value below (port 55432, see docker/docker-compose.yml)
# Prod: Neon Console > Connect > role dex_app > Connection pooling ON.
#       Host contains "-pooler". See docs/SETUP.md, "Neon".
DATABASE_URL=postgres://dex_app:dex_app_dev@localhost:55432/dex

# Owner connection for migrations and seeds only. Never give it to a running app.
# Used by: pnpm db:migrate, pnpm db:seed:dev, pnpm db:generate, integration tests
# Local: the value below
# Prod: Neon Console > Connect > owner role > Connection pooling OFF (direct).
DATABASE_ADMIN_URL=postgres://dex_admin:dex_admin_dev@localhost:55432/dex

# Maximum connections per process (1-100). Default: 10.
DATABASE_POOL_MAX=10

# --- Redis (BullMQ) ----------------------------------------------------------

# Used by: admin, worker
# Local: the value below (port 56379)
# Prod: from your Redis provider, normally rediss:// (TLS). The instance MUST use
#       maxmemory-policy noeviction or BullMQ can lose jobs.
REDIS_URL=redis://localhost:56379

# --- Object storage (S3 API: RustFS locally, Cloudflare R2 in production) ------

# Used by: web, worker
# Local: the value below (port 59000)
# Prod: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#       The account ID is on the Cloudflare dashboard's R2 Overview page.
S3_ENDPOINT=http://localhost:59000

# Local: us-east-1   Prod: auto
S3_REGION=us-east-1

# Local: dex-media (created by pnpm infra:up)
# Prod: dex-prod. Create it in R2 with public access disabled.
S3_BUCKET=dex-media

# Used by: web, worker
# Local: must match RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY in docker-compose.yml
# Prod: R2 > Overview > API Tokens > Manage > create a token with "Object Read &
#       Write" limited to this bucket. The secret is shown only once.
S3_ACCESS_KEY_ID=dex_rustfs
S3_SECRET_ACCESS_KEY=dex_rustfs_dev

# Local: true (RustFS needs path-style URLs)   Prod: false
S3_FORCE_PATH_STYLE=true

# Signed URL lifetime in seconds (60-900). Default: 600.
S3_SIGNED_URL_TTL_SECONDS=600

# --- Customer auth (apps/web) ------------------------------------------------

# Signs customer sessions. At least 32 characters. Generate with:
#   openssl rand -base64 48
# Changing it signs every customer out. Use a different value per environment.
# Used by: web
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-48

# Public URL of apps/web, no trailing slash.
# Used by: web
# Local: http://localhost:3000   Prod: https://app.your-domain.com
BETTER_AUTH_URL=http://localhost:3000

# Same URL as BETTER_AUTH_URL. Inlined into browser code at BUILD time, so for
# Docker pass it as a build arg: --build-arg NEXT_PUBLIC_APP_URL=https://...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Staff auth (apps/admin): a separate realm with a separate secret -----------

# Signs staff sessions. At least 32 characters and different from
# BETTER_AUTH_SECRET. Generate with: openssl rand -base64 48
# Used by: admin
STAFF_AUTH_SECRET=replace-with-a-different-output-of-openssl-rand-base64-48

# Public URL of apps/admin, no trailing slash.
# Local: http://localhost:3100   Prod: https://admin.your-domain.com
STAFF_AUTH_URL=http://localhost:3100

# Same URL as STAFF_AUTH_URL. Build-time, like NEXT_PUBLIC_APP_URL:
# --build-arg NEXT_PUBLIC_ADMIN_URL=https://...
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100

# Comma-separated CIDR ranges allowed to reach admin. Empty disables the check.
# Local: empty   Prod: your office/VPN ranges, e.g. 203.0.113.0/24
STAFF_IP_ALLOWLIST=

# Require MFA for all staff. Local: false   Prod: true
STAFF_REQUIRE_MFA=false

# --- Email -------------------------------------------------------------------

# Only smtp is implemented. Used by: web, admin
EMAIL_PROVIDER=smtp

# Sender address. Local: anything   Prod: an address on your verified domain.
EMAIL_FROM=noreply@dex.test

# Local: Mailpit, which catches all mail. Read it at http://localhost:58025
# Prod: from your SMTP relay. Port 465 uses smtps://. URL-encode special
#       characters in the password. Example for Resend:
#       smtps://resend:<RESEND_API_KEY>@smtp.resend.com:465
SMTP_URL=smtp://localhost:51025

# --- Worker (apps/worker) ----------------------------------------------------

# Comma-separated queues this process consumes:
# system, ingest, ai, media, render, notify. Default: system.
# Only `system` has a handler today, in Phase 1.
WORKER_ROLES=system

# Port for /health and /ready. Default: 4000.
WORKER_HTTP_PORT=4000

# Jobs processed at once, per queue (1-64). Default: 2.
WORKER_CONCURRENCY=2

# --- Observability (optional: leave empty to turn off) -------------------------

# Service name on traces. Defaults to dex-web, dex-admin or dex-worker. Leave it
# empty unless each process gets its own value.
OTEL_SERVICE_NAME=

# Prod: Grafana Cloud portal > your stack > OpenTelemetry > Configure.
#       Looks like https://otlp-gateway-<REGION>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# Prod: shown on the same page. Looks like: Authorization=Basic <token>
OTEL_EXPORTER_OTLP_HEADERS=

# Validated, but nothing sends to Sentry yet. Setting it has no effect today.
SENTRY_DSN=

# --- Development and test only: never set these in production --------------------

# First staff super admin, created by pnpm db:seed:dev. Tests read these too.
SEED_STAFF_EMAIL=admin@dex.localhost
SEED_STAFF_PASSWORD=change-me-before-anything-else!

# Used by pnpm test:e2e. Defaults: localhost:3000, localhost:3100, localhost:8025.
MAILPIT_URL=http://localhost:58025
# E2E_WEB_URL=http://localhost:3000
# E2E_ADMIN_URL=http://localhost:3100
# Use your installed Chrome instead of downloading Playwright's browser.
# E2E_CHROME_CHANNEL=chrome
