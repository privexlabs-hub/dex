# Secrets must never enter a build context.
.env
.env.*
**/.env
**/.env.*
!.env.example

# Rebuilt inside the image. Local copies would overwrite the installed tree,
# and a stale tsbuildinfo makes tsc skip emitting dist/.
**/node_modules
**/.next
**/dist
**/.turbo
**/*.tsbuildinfo

.git
docker/data
playwright-report
test-results
coverage
